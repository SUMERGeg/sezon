# Set the public origin before the production build, e.g. https://your-domain.example
# Empty: preview mode, no indexing/canonical URLs and an empty sitemap.
SITE_URL=

# GitHub Pages export only: /sezon for SUMERGeg/sezon; empty for a root/custom domain.
# The Pages workflow determines both SITE_URL and PAGES_BASE_PATH automatically.
PAGES_BASE_PATH=/sezon
